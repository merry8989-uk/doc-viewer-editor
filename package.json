{
  "name": "docforge",
  "productName": "DocForge",
  "version": "1.0.0",
  "description": "Offline document viewer & editor — open, edit, convert, compress, merge, enhance and scan documents on your device.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0"
  },
  "build": {
    "appId": "com.docforge.app",
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "vendor/**",
      "manifest.webmanifest",
      "electron/**"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}